<Window x:Class="NhlWorkbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NhlWorkbench.App.ViewModels"
        xmlns:views="clr-namespace:NhlWorkbench.App.Views"
        Title="NHL Legacy Workbench" Width="1320" Height="840" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Arena}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:MainViewModel}"><views:RinkView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SetupViewModel}"><views:SetupView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:IceViewModel}"><views:IceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TeamsViewModel}"><views:TeamsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RosterViewModel}"><views:RosterView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DatabaseViewModel}"><views:DatabaseView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SoundsViewModel}"><views:SoundsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GameTextViewModel}"><views:GameTextView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:VideosViewModel}"><views:VideosView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TexturesViewModel}"><views:TexturesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FilesViewModel}"><views:FilesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModViewModel}"><views:ModView /></DataTemplate>

    <Style x:Key="ScoreNumber" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ScoreLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RailLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    <Style x:Key="RailIcon" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Scoreboard -->
    <Border Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Canvas Width="30" Height="30" Margin="0,0,12,0">
            <Ellipse Width="30" Height="30" Stroke="{StaticResource BlueLine}" StrokeThickness="2" />
            <Rectangle Canvas.Left="14" Width="2" Height="30" Fill="{StaticResource RedLine}" />
            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="6" Height="6" Fill="{StaticResource Ice}" />
          </Canvas>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="NHL LEGACY WORKBENCH" FontFamily="{StaticResource DisplayFont}" FontSize="17" />
            <TextBlock Text="{Binding GameTitle}" Style="{StaticResource Label}" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource Arena}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Width="210" Margin="16,0">
              <TextBlock Text="{Binding ModTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="15" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
              <TextBlock Text="CURRENT MOD" Style="{StaticResource ScoreLabel}" />
            </StackPanel>
            <Rectangle Width="1" Fill="{StaticResource Line}" Margin="0,4" />
            <StackPanel Width="72">
              <TextBlock Text="{Binding EditCount, StringFormat={}{0:00}}" Style="{StaticResource ScoreNumber}" />
              <TextBlock Text="EDITS" Style="{StaticResource ScoreLabel}" />
            </StackPanel>
            <StackPanel Width="72">
              <TextBlock Text="{Binding WarningCount, StringFormat={}{0:00}}" Style="{StaticResource ScoreNumber}" Foreground="{StaticResource Caution}" />
              <TextBlock Text="WARNINGS" Style="{StaticResource ScoreLabel}" />
            </StackPanel>
            <StackPanel Width="72">
              <TextBlock Text="{Binding ErrorCount, StringFormat={}{0:00}}" Style="{StaticResource ScoreNumber}" Foreground="{StaticResource RedLine}" />
              <TextBlock Text="ERRORS" Style="{StaticResource ScoreLabel}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                Command="{Binding QuickSearch.OpenCommand}" ToolTip="Find any team, player, sound, picture or string. Ctrl+/ lists every shortcut." WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock><Run Text="Search" /><Run Text="  Ctrl+K" Foreground="{StaticResource TextMuted}" /></TextBlock>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
          <Button Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
          <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Rail -->
    <Border Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="0,6,0,0">
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowRinkCommand}" Tag="{Binding IsRinkPage}" ToolTip="The rink (Ctrl+1)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M7,5 H17 A5,5 0 0 1 22,10 V14 A5,5 0 0 1 17,19 H7 A5,5 0 0 1 2,14 V10 A5,5 0 0 1 7,5 Z M12,5 V19 M12,9.5 A2.5,2.5 0 1 1 12,14.5 A2.5,2.5 0 1 1 12,9.5" />
            <TextBlock Text="RINK" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowTeamsCommand}" Tag="{Binding IsTeamsRailActive}" ToolTip="Each team and everything drawn for it (Ctrl+2)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M12,2.5 L20,5.5 V11.5 C20,16.5 16.5,20 12,21.5 C7.5,20 4,16.5 4,11.5 V5.5 Z" />
            <TextBlock Text="TEAMS" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowUniformsCommand}" Tag="{Binding IsUniformsPage}" ToolTip="Each team's uniforms, bundled kit by kit (Ctrl+3)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M8.5,3 L3,6.5 L5,11 L7,10 V21 H17 V10 L19,11 L21,6.5 L15.5,3 C14.5,5 9.5,5 8.5,3 Z" />
            <TextBlock Text="UNIFORMS" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowRosterCommand}" Tag="{Binding IsRosterPage}" ToolTip="Each team's players: names, ratings, lines and trades (Ctrl+4)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M9,4 A3.5,3.5 0 1 1 9,11 A3.5,3.5 0 1 1 9,4 M3,20 C3,15.5 5.5,13.5 9,13.5 C12.5,13.5 15,15.5 15,20 M16,4.3 A3.5,3.5 0 0 1 16,10.7 M17.5,13.8 C20,14.5 21.5,16.5 21.5,20" />
            <TextBlock Text="ROSTER" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowIceCommand}" Tag="{Binding IsIcePage}" ToolTip="Logos on the ice (Ctrl+5)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 M12,8 L13.2,10.8 L16,11 L13.8,12.9 L14.5,16 L12,14.3 L9.5,16 L10.2,12.9 L8,11 L10.8,10.8 Z" />
            <TextBlock Text="ICE" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowTexturesCommand}" Tag="{Binding IsTexturesPage}" ToolTip="Every texture in the game (Ctrl+6)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M4,4 H20 V20 H4 Z M4,12 H20 M12,4 V20" />
            <TextBlock Text="TEXTURES" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowSoundsCommand}" Tag="{Binding IsSoundsPage}" ToolTip="Goal horns, chants and every other sound (Ctrl+7)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M4,9.5 H8 L13,5 V19 L8,14.5 H4 Z M16.5,9 A4,4 0 0 1 16.5,15 M19,6.5 A8,8 0 0 1 19,17.5" />
            <TextBlock Text="SOUNDS" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowVideosCommand}" Tag="{Binding IsVideosPage}" ToolTip="Every movie in the game (Ctrl+8)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M3,5 H21 V19 H3 Z M10,9 L15.5,12 L10,15 Z" />
            <TextBlock Text="VIDEOS" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowTextCommand}" Tag="{Binding IsTextPage}" ToolTip="Team names, menus and every other string (Ctrl+9)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M5,5 H19 M12,5 V19 M9,19 H15" />
            <TextBlock Text="TEXT" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowFilesCommand}" Tag="{Binding IsFilesPage}" ToolTip="Explorer: every game file (Ctrl+0)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M3,6 H9 L11,8.5 H21 V19 H3 Z" />
            <TextBlock Text="EXPLORER" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowDatabaseCommand}" Tag="{Binding IsDatabasePage}" ToolTip="Every table in the game's databases (Ctrl+-)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M12,3 C16.5,3 20,4.3 20,6 C20,7.7 16.5,9 12,9 C7.5,9 4,7.7 4,6 C4,4.3 7.5,3 12,3 M4,6 V18 C4,19.7 7.5,21 12,21 C16.5,21 20,19.7 20,18 V6 M4,12 C4,13.7 7.5,15 12,15 C16.5,15 20,13.7 20,12" />
            <TextBlock Text="DATABASE" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
      </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,4,0,6">
        <StackPanel>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowSetupCommand}" Tag="{Binding IsSetupPage}" ToolTip="Getting started (F1)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M3,6 L5,8 L8,4 M11,6 H21 M3,12 L5,14 L8,10 M11,12 H21 M3,18 L5,20 L8,16 M11,18 H21" />
            <TextBlock Text="SETUP" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RailButton}" Command="{Binding ShowModCommand}" Tag="{Binding IsModPage}" ToolTip="Your mod: check, export, install (Ctrl+=)">
          <StackPanel>
            <Path Style="{StaticResource RailIcon}" Data="M4,20 L4,6 H20 L20,20 M4,6 L7,3 H17 L20,6 M4,10 H20 M8,6 V20 M12,6 V20 M16,6 V20 M4,15 H20" />
            <TextBlock Text="MY MOD" Style="{StaticResource RailLabel}" />
          </StackPanel>
        </Button>
        </StackPanel>
      </Border>
      </Grid>
    </Border>

    <!-- Page -->
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

    <!-- Status -->
    <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </Border>

    <!-- Quick search -->
    <Grid Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#AA0A0F1A" Visibility="{Binding QuickSearch.IsOpen, Converter={StaticResource ShowIf}}"
          MouseDown="OnQuickSearchBackdrop" WindowChrome.IsHitTestVisibleInChrome="True">
      <Border Width="640" MaxWidth="9999" VerticalAlignment="Top" Margin="16,70,16,16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" MouseDown="OnQuickSearchPanel">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBox x:Name="QuickSearchBox" Text="{Binding QuickSearch.Query, UpdateSourceTrigger=PropertyChanged, Delay=120}" PreviewKeyDown="OnQuickSearchKey" FontSize="15" AutomationProperties.Name="Search everything" />
          <TextBlock Grid.Row="1" Text="{Binding QuickSearch.Hint}" Style="{StaticResource Muted}" FontSize="11" Margin="2,6,0,8" TextWrapping="Wrap" />
          <ListBox x:Name="QuickSearchList" Grid.Row="2" ItemsSource="{Binding QuickSearch.Results}" SelectedItem="{Binding QuickSearch.Selected}" ItemContainerStyle="{StaticResource RowItem}" MaxHeight="440"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnQuickSearchChosen" AutomationProperties.Name="Results">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Kind}" Style="{StaticResource Label}" FontSize="10" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- Busy: a puck sliding along the red line -->
    <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Background="#CC0A0F1A" Visibility="{Binding BusyText, Converter={StaticResource ShowIfSet}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Canvas Width="260" Height="16" Margin="0,0,0,16">
          <Rectangle Canvas.Top="7" Width="260" Height="2" Fill="{StaticResource RedLine}" />
          <Ellipse Canvas.Top="1" Width="14" Height="14" Fill="{StaticResource Ice}">
            <Ellipse.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="0" To="246" Duration="0:0:0.9">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Ellipse.Triggers>
          </Ellipse>
        </Canvas>
        <TextBlock Text="{Binding BusyText}" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
