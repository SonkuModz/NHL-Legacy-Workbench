<UserControl x:Class="NhlWorkbench.App.Views.ModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="30,22,30,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="370" />
    </Grid.ColumnDefinitions>

    <!-- Title -->
    <Grid Grid.ColumnSpan="3" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Main.ModTitle}" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,20,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Main.HasRecentMods, Converter={StaticResource ShowIf}}">
          <TextBlock Text="RECENT" Style="{StaticResource Label}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ItemsControl ItemsSource="{Binding Main.RecentMods}" Focusable="False" AutomationProperties.Name="Recent mods">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Name}" ToolTip="{Binding Folder}" Style="{StaticResource SmallLink}" Margin="0,0,12,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.Main.OpenRecentModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="New mod" Style="{StaticResource GhostButton}" Command="{Binding Main.NewModCommand}" Margin="0,0,10,0" />
        <Button Content="Open mod" Style="{StaticResource GhostButton}" Command="{Binding Main.OpenModCommand}" Margin="0,0,10,0" />
        <Button Content="Show folder" Style="{StaticResource GhostButton}" Command="{Binding Main.OpenProjectFolderCommand}" Visibility="{Binding Main.HasProject, Converter={StaticResource ShowIf}}" />
      </StackPanel>
    </Grid>

    <!-- Files and checks -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="18,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="CHANGED FILES" Style="{StaticResource Label}" Margin="0,0,0,8" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Files}" ItemContainerStyle="{StaticResource RowItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding What}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{Binding HasWhat, Converter={StaticResource ShowIf}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0" />
                  <Button Grid.Column="2" Content="Undo" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                          Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     Text="Nothing changed yet. Head to the Ice page and swap in a logo.">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Files.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0" MaxHeight="230" Visibility="{Binding HasIssues, Converter={StaticResource ShowIf}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="CHECKS" Style="{StaticResource Label}" Margin="0,0,0,8" />
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Issues}">
            <ItemsControl.Template>
              <ControlTemplate>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource Caution}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource RedLine}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Where}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                  </StackPanel>
                  <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="13" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>

    <!-- Send it -->
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Style="{StaticResource Card}" Padding="20,18">
        <StackPanel>
          <TextBlock Text="PLAY IT" Style="{StaticResource Label}" />
          <TextBlock Text="Install in your game" Style="{StaticResource SubHeading}" FontSize="20" Margin="0,4,0,4" />
          <TextBlock Style="{StaticResource Muted}" LineHeight="19" FontSize="13" Text="Runs the game's own launcher to add this mod. New mods go to the top of its list, and the top mod wins any clash." />
          <Button Content="Install mod" Style="{StaticResource PrimaryButton}" Command="{Binding Main.InstallCommand}" Margin="0,14,0,0" />
          <Button Content="Open the launcher" Style="{StaticResource GhostButton}" Command="{Binding Main.OpenLauncherCommand}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="SHARE IT" Style="{StaticResource Label}" />
          <TextBlock Text="Export the mod" Style="{StaticResource SubHeading}" FontSize="20" Margin="0,4,0,4" />
          <TextBlock Style="{StaticResource Muted}" LineHeight="19" FontSize="13" Text="Anyone with the recomp can drop this on their launcher to install it." />
          <Button Content="Save as a zip" Style="{StaticResource GhostButton}" Command="{Binding Main.ExportZipCommand}" Margin="0,14,0,0" />
          <Button Content="Save as a folder" Style="{StaticResource GhostButton}" Command="{Binding Main.ExportFolderCommand}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,14,0,0" Visibility="{Binding Main.HasProject, Converter={StaticResource ShowIf}}">
        <StackPanel>
          <TextBlock Text="KEEP IT SAFE" Style="{StaticResource Label}" />
          <TextBlock Text="Snapshots" Style="{StaticResource SubHeading}" FontSize="20" Margin="0,4,0,4" />
          <TextBlock Style="{StaticResource Muted}" LineHeight="19" FontSize="13" TextWrapping="Wrap" Text="Keep a copy of the mod to come back to. Exports don't include them." />
          <Button Content="Save a snapshot" Style="{StaticResource GhostButton}" Command="{Binding TakeSnapshotCommand}" Margin="0,14,0,0" />
          <ItemsControl ItemsSource="{Binding Snapshots}" Focusable="False" Margin="0,10,0,0" Visibility="{Binding HasSnapshots, Converter={StaticResource ShowIf}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Facts}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="Go back" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Margin="0,0,4,0" CommandParameter="{Binding}"
                            Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Content="Delete" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" CommandParameter="{Binding}"
                            Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,14,0,0" Visibility="{Binding HasInstalled, Converter={StaticResource ShowIf}}">
        <StackPanel>
          <TextBlock Text="IN YOUR GAME" Style="{StaticResource Label}" />
          <TextBlock Text="Installed mods" Style="{StaticResource SubHeading}" FontSize="20" Margin="0,4,0,4" />
          <TextBlock Style="{StaticResource Muted}" LineHeight="19" FontSize="13" TextWrapping="Wrap" Text="In the launcher's order. The top one wins any clash." />
          <ItemsControl ItemsSource="{Binding Installed}" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Facts}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Clash}" Foreground="{StaticResource Caution}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                             Visibility="{Binding HasClash, Converter={StaticResource ShowIf}}" />
                  <Button Content="Copy files from it" Style="{StaticResource SmallLink}" HorizontalAlignment="Left" Margin="0,3,0,0" CommandParameter="{Binding}"
                          Command="{Binding DataContext.OpenCopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Visibility="{Binding CanCopy, Converter={StaticResource ShowIf}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>

    <!-- Copying from an installed mod -->
    <Grid Grid.RowSpan="2" Grid.ColumnSpan="3" Background="{StaticResource Arena}" Visibility="{Binding IsCopyOpen, Converter={StaticResource ShowIf}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding CopyTitle}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12"
                   Text="Tick what to bring into your mod. That mod stays as it is. Its maker's work is still theirs, so ask before sharing a mod with their files in it." />
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox Text="{Binding CopyQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Search this mod's files" />
          <TextBlock Text="Search by team, file or folder" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CopyQuery}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <Button Grid.Column="1" Content="Tick these" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding TickShownCommand}" CommandParameter="yes" />
        <Button Grid.Column="2" Content="Untick these" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding TickShownCommand}" CommandParameter="no" />
      </Grid>
      <ListBox Grid.Row="2" ItemsSource="{Binding CopyRows}" ItemContainerStyle="{StaticResource PlainRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Files in that mod">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,3,14,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
              </Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsTicked}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Path}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Path}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                <TextBlock Text="{Binding What}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="YOUR MOD HAS THIS" Foreground="{StaticResource Caution}" FontFamily="{StaticResource DisplayFont}" FontSize="10" VerticalAlignment="Center" Margin="10,0"
                         Visibility="{Binding IsInMine, Converter={StaticResource ShowIf}}" ToolTip="Ticking this replaces your version" />
              <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CopySummary}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding CloseCopyCommand}" />
        <Button Grid.Column="2" Content="Copy into my mod" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding CopyTickedCommand}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
