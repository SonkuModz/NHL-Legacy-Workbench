<UserControl x:Class="NhlWorkbench.App.Views.RinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="FaceoffCircle" TargetType="Ellipse">
      <Setter Property="Stroke" Value="{StaticResource RedLine}" />
      <Setter Property="StrokeThickness" Value="2.5" />
      <Setter Property="Width" Value="124" />
      <Setter Property="Height" Value="124" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- The clickable center circle -->
    <Style x:Key="CenterIceButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Glow" Fill="{StaticResource BlueLine}" Opacity="0.12">
                <Ellipse.Effect><BlurEffect Radius="30" /></Ellipse.Effect>
              </Ellipse>
              <Ellipse x:Name="Disc" Fill="#14233D" Stroke="{StaticResource BlueLine}" StrokeThickness="3.5" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                <Setter TargetName="Disc" Property="Fill" Value="#1D3358" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Disc" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Painted ad spots on the ice -->
    <Style x:Key="IceLogoSpot" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="48" />
      <Setter Property="ToolTip" Value="Open the ice logos" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Spot" Background="#101D33" BorderBrush="{StaticResource TextMuted}" BorderThickness="1.5" CornerRadius="8">
              <TextBlock Text="ICE LOGO" Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Spot" Property="BorderBrush" Value="{StaticResource BlueLine}" />
                <Setter TargetName="Spot" Property="Background" Value="#1D3358" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Spot" Property="BorderBrush" Value="{StaticResource BlueLine}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LaterChip" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="30,22,30,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Heading -->
    <Grid>
      <StackPanel>
        <TextBlock Text="PICK YOUR SPOT ON THE ICE" Style="{StaticResource Heading}" />
        <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" Text="Click the center circle or an ice logo to start. Your edits stay in your mod until you install them." />
      </StackPanel>
    </Grid>

    <!-- Rink -->
    <Viewbox Grid.Row="1" Margin="0,14" Stretch="Uniform">
      <Canvas Width="1000" Height="430">
        <Canvas.Clip>
          <RectangleGeometry Rect="0,0,1000,430" RadiusX="150" RadiusY="150" />
        </Canvas.Clip>
        <Rectangle Width="1000" Height="430">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#101C31" Offset="0" />
              <GradientStop Color="#0B1422" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <!-- Goal lines and creases -->
        <Rectangle Canvas.Left="66" Width="3" Height="430" Fill="{StaticResource RedLine}" Opacity="0.6" />
        <Rectangle Canvas.Left="931" Width="3" Height="430" Fill="{StaticResource RedLine}" Opacity="0.6" />
        <Path Data="M69,185 A32,32 0 0 1 69,245 Z" Fill="#1C3A66" Stroke="{StaticResource BlueLine}" StrokeThickness="2" />
        <Path Data="M931,185 A32,32 0 0 0 931,245 Z" Fill="#1C3A66" Stroke="{StaticResource BlueLine}" StrokeThickness="2" />

        <!-- Blue lines and the red line -->
        <Rectangle Canvas.Left="340" Width="9" Height="430" Fill="{StaticResource BlueLine}" />
        <Rectangle Canvas.Left="651" Width="9" Height="430" Fill="{StaticResource BlueLine}" />
        <Rectangle Canvas.Left="496" Width="8" Height="430" Fill="{StaticResource RedLine}" />

        <!-- End zone faceoff circles -->
        <Ellipse Canvas.Left="136" Canvas.Top="48" Style="{StaticResource FaceoffCircle}" />
        <Ellipse Canvas.Left="136" Canvas.Top="258" Style="{StaticResource FaceoffCircle}" />
        <Ellipse Canvas.Left="740" Canvas.Top="48" Style="{StaticResource FaceoffCircle}" />
        <Ellipse Canvas.Left="740" Canvas.Top="258" Style="{StaticResource FaceoffCircle}" />
        <Ellipse Canvas.Left="192" Canvas.Top="104" Width="12" Height="12" Fill="{StaticResource RedLine}" />
        <Ellipse Canvas.Left="192" Canvas.Top="314" Width="12" Height="12" Fill="{StaticResource RedLine}" />
        <Ellipse Canvas.Left="796" Canvas.Top="104" Width="12" Height="12" Fill="{StaticResource RedLine}" />
        <Ellipse Canvas.Left="796" Canvas.Top="314" Width="12" Height="12" Fill="{StaticResource RedLine}" />

        <!-- Ice logos -->
        <Button Canvas.Left="382" Canvas.Top="52" Style="{StaticResource IceLogoSpot}" Command="{Binding ShowIceLogosCommand}" />
        <Button Canvas.Left="522" Canvas.Top="52" Style="{StaticResource IceLogoSpot}" Command="{Binding ShowIceLogosCommand}" />
        <Button Canvas.Left="382" Canvas.Top="330" Style="{StaticResource IceLogoSpot}" Command="{Binding ShowIceLogosCommand}" />
        <Button Canvas.Left="522" Canvas.Top="330" Style="{StaticResource IceLogoSpot}" Command="{Binding ShowIceLogosCommand}" />

        <!-- Center ice -->
        <Button Canvas.Left="410" Canvas.Top="125" Width="180" Height="180" Style="{StaticResource CenterIceButton}" Command="{Binding ShowCenterIceCommand}" ToolTip="Open the center-ice logos">
          <StackPanel>
            <TextBlock Text="CENTER ICE" FontFamily="{StaticResource DisplayFont}" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Ice.CenterIceCount, StringFormat={}{0} logos}" Style="{StaticResource Label}" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Button>

        <!-- Boards -->
        <Rectangle Width="1000" Height="430" RadiusX="150" RadiusY="150" Stroke="#4A6087" StrokeThickness="5" IsHitTestVisible="False" />
      </Canvas>
    </Viewbox>

    <!-- Connect -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12" Visibility="{Binding HasGame, Converter={StaticResource HideIf}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Connect your game to get on the ice" Style="{StaticResource SubHeading}" />
          <TextBlock Text="Pick your NHL Legacy Native folder. The Workbench only reads it." Style="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="Use a disc image" Style="{StaticResource GhostButton}" Command="{Binding PickDiscImageCommand}" Margin="0,0,10,0" />
        <Button Grid.Column="2" Content="Connect game folder" Style="{StaticResource PrimaryButton}" Command="{Binding PickGameCommand}" />
      </Grid>
    </Border>

    <!-- What's coming, and the game link -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      </StackPanel>
      <Button Grid.Column="1" Content="Change game folder" Style="{StaticResource GhostButton}" Command="{Binding PickGameCommand}" Visibility="{Binding HasGame, Converter={StaticResource ShowIf}}" />
    </Grid>
  </Grid>
</UserControl>
