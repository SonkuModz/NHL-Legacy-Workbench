<UserControl x:Class="NhlWorkbench.App.Views.RosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <ItemsPanelTemplate x:Key="Wrapped"><WrapPanel /></ItemsPanelTemplate>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <DataTemplate x:Key="ChoiceTemplate">
      <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}"
              Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="336" />
    </Grid.ColumnDefinitions>

    <!-- The teams, by league -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="14,16,14,10">
          <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search teams" />
          <TextBlock Text="Search teams" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Query}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" ItemContainerStyle="{StaticResource TeamRowItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Teams">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="16,14,8,6" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="40" Loaded="OnEntryLoaded" Unloaded="OnEntryUnloaded">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Color}" CornerRadius="2" Margin="0,5" />
                <Image Grid.Column="1" Source="{Binding Crest.Thumbnail}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24,0" TextWrapping="Wrap"
                   Text="Connect your game on the Rink page to see its rosters." Visibility="{Binding DataContext.HasGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HideIf}}" />
      </Grid>
    </Border>

    <!-- The team's players -->
    <Grid Grid.Column="1" Margin="24,16,12,0">
      <!-- Line spots need room to show players' names, and picking them doesn't use the player panel. -->
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding WantsWholeWidth}" Value="True">
              <Setter Property="Grid.ColumnSpan" Value="2" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Which roster this is -->
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding SourceTitle}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SourceNote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="Copy into my mod and edit" Style="{StaticResource PrimaryButton}" Command="{Binding CopyIntoModCommand}"
                      Visibility="{Binding CanCopy, Converter={StaticResource ShowIf}}" />
              <Button Content="Remove from my mod" Style="{StaticResource GhostButton}" Command="{Binding RemoveFromModCommand}"
                      Visibility="{Binding IsEditing, Converter={StaticResource ShowIf}}" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Sources}" ItemsPanel="{StaticResource Wrapped}" Focusable="False" Margin="0,8,0,-6"
                        Visibility="{Binding IsEditing, Converter={StaticResource HideIf}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" ToolTip="{Binding Source.Note}" Style="{StaticResource ChoiceButton}"
                        Command="{Binding DataContext.ShowSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- The team, and finding anyone -->
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="2*" MaxWidth="210" />
        </Grid.ColumnDefinitions>
        <Grid Width="52" Height="52" Margin="0,0,12,0">
          <Border Background="{Binding SelectedTeam.Color}" CornerRadius="10" Opacity="0.28" />
          <Image Source="{Binding SelectedTeam.Crest.Thumbnail}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedTeam.Name}" ToolTip="{Binding SelectedTeam.Name}" Style="{StaticResource Heading}" FontSize="22" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <TextBlock Text="{Binding TeamFacts}" ToolTip="{Binding TeamFacts}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>
        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBox Text="{Binding PlayerQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Find a player" />
          <TextBlock Text="Find a player" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PlayerQuery}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>

      <!-- A swap in progress -->
      <StackPanel Grid.Row="2">
      <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource RedLine}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,10"
              Visibility="{Binding IsTrading, Converter={StaticResource ShowIf}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding TradeHeading}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
            <TextBlock Text="{Binding TradeTargetText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Content="Swap them" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmTradeCommand}" Margin="0,0,8,0" />
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelTradeCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Changing many ratings at once -->
      <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
              Visibility="{Binding IsBulkOpen, Converter={StaticResource ShowIf}}">
        <StackPanel>
          <TextBlock Text="Change many ratings at once" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
          <TextBlock Text="WHERE" Style="{StaticResource FieldLabel}" />
          <ItemsControl ItemsSource="{Binding BulkScopes}" ItemsPanel="{StaticResource Wrapped}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseBulkScopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="WHO" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
          <ItemsControl ItemsSource="{Binding BulkWho}" ItemsPanel="{StaticResource Wrapped}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseBulkWhoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="WHICH RATINGS" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
          <ItemsControl ItemsSource="{Binding BulkWhat}" ItemsPanel="{StaticResource Wrapped}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseBulkWhatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="ADD" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding BulkAmount, UpdateSourceTrigger=PropertyChanged}" Width="60" TextAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="How much to add" />
            <Button Content="Change them" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyBulkCommand}" Margin="0,0,8,0" />
            <Button Content="Close" Style="{StaticResource GhostButton}" Command="{Binding ToggleBulkCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding BulkProblem}" Foreground="{StaticResource RedLine}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding HasBulkProblem, Converter={StaticResource ShowIf}}" />
        </StackPanel>
      </Border>
      </StackPanel>

      <!-- The tabs, and stepping back through changes -->
      <Grid Grid.Row="3" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource TabButton}" FontSize="14" Margin="0,0,14,0" Tag="{Binding IsPlayersTab}" Command="{Binding ShowTabCommand}" CommandParameter="Players">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="PLAYERS" />
          </Button>
          <Button Style="{StaticResource TabButton}" FontSize="14" Margin="0,0,14,0" Tag="{Binding IsLinesTab}" Command="{Binding ShowTabCommand}" CommandParameter="Lines">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="LINES" />
          </Button>
          <Button Style="{StaticResource TabButton}" FontSize="14" Margin="0,0,14,0" Tag="{Binding IsLeagueTab}" Command="{Binding ShowTabCommand}" CommandParameter="League">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="LEAGUE" />
          </Button>
          <Button Style="{StaticResource TabButton}" FontSize="14" Margin="0,0,14,0" Tag="{Binding IsChecksTab}" Command="{Binding ShowTabCommand}" CommandParameter="Checks">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="CHECKS" />
          </Button>
          <Button Style="{StaticResource TabButton}" FontSize="14" Margin="0,0,14,0" Tag="{Binding IsChangesTab}" Command="{Binding ShowTabCommand}" CommandParameter="Changes">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="CHANGES" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource ShowIf}}">
          <Button Content="Undo" Style="{StaticResource ToolButton}" Margin="0,0,6,0" Command="{Binding UndoCommand}" ToolTip="{Binding UndoTip}" ToolTipService.ShowOnDisabled="True" />
          <Button Content="Redo" Style="{StaticResource ToolButton}" Margin="0" Command="{Binding RedoCommand}" ToolTip="{Binding RedoTip}" ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
      </Grid>

      <!-- The Players tab -->
      <Grid Grid.Row="4" Visibility="{Binding IsPlayersTab, Converter={StaticResource ShowIf}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- Column names -->
      <Grid Margin="12,0,26,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="NO" Style="{StaticResource ColumnHead}" />
        <TextBlock Grid.Column="1" Text="PLAYER" Style="{StaticResource ColumnHead}" />
        <TextBlock Grid.Column="2" Text="{Binding NoteHeading}" Style="{StaticResource ColumnHead}" />
        <TextBlock Grid.Column="3" Text="POS" Style="{StaticResource ColumnHead}" />
        <TextBlock Grid.Column="4" Text="OVR" Style="{StaticResource ColumnHead}" HorizontalAlignment="Right" />
      </Grid>

      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" ItemContainerStyle="{StaticResource RowItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Players">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" Margin="2,12,0,5" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Height="26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="34" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Player.Jersey}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource DisplayFont}" FontSize="14" VerticalAlignment="Center" />
              <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MaxWidth="400" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Player.FullName}" ToolTip="{Binding Player.FullName}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Background="{StaticResource BlueLine}" CornerRadius="3" Padding="5,0" Margin="6,0,6,0" VerticalAlignment="Center"
                        Visibility="{Binding HasLetter, Converter={StaticResource ShowIf}}">
                  <TextBlock Text="{Binding Letter}" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="11" />
                </Border>
              </Grid>
              <TextBlock Grid.Column="2" Text="{Binding Note}" ToolTip="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              <TextBlock Grid.Column="3" Text="{Binding Player.PositionName}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding Player.Overall}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False" />

      <!-- Tools for the whole list -->
      <WrapPanel Grid.Row="2" Margin="0,8,0,4">
        <Button Content="Team art" Style="{StaticResource ToolButton}" Command="{Binding OpenTeamArtCommand}" ToolTip="See this team's logos and uniforms" />
        <Button Content="Change ratings" Style="{StaticResource ToolButton}" Command="{Binding ToggleBulkCommand}" ToolTip="Raise or lower ratings for a team or a whole league"
                Visibility="{Binding IsEditing, Converter={StaticResource ShowIf}}" />
        <Button Content="Export team CSV" Style="{StaticResource ToolButton}" Command="{Binding ExportCsvCommand}" CommandParameter="team" ToolTip="Save this team's players for a spreadsheet" />
        <Button Content="Export all CSV" Style="{StaticResource ToolButton}" Command="{Binding ExportCsvCommand}" CommandParameter="all" ToolTip="Save every player on this roster for a spreadsheet" />
        <Button Content="Import CSV" Style="{StaticResource ToolButton}" Command="{Binding ImportCsvCommand}" ToolTip="Apply a spreadsheet saved from Export"
                Visibility="{Binding IsEditing, Converter={StaticResource ShowIf}}" />
      </WrapPanel>
      </Grid>

      <!-- The Lines tab -->
      <Grid Grid.Row="4" Visibility="{Binding IsLinesTab, Converter={StaticResource ShowIf}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ItemsControl ItemsSource="{Binding LineSections}" ItemsPanel="{StaticResource Wrapped}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Column="1" Content="Best lines" Style="{StaticResource ToolButton}" Command="{Binding BestLinesCommand}" VerticalAlignment="Top"
                  ToolTip="Set every line and special team from the ratings. Extra attackers stay as they are."
                  Visibility="{Binding IsEditing, Converter={StaticResource ShowIf}}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding LineNote}" Foreground="{StaticResource Caution}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                   Visibility="{Binding HasLineNote, Converter={StaticResource ShowIf}}" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding LineUnitRows}" Focusable="False" IsEnabled="{Binding IsEditing}" Margin="0,0,12,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Spots}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding Spot.Label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                                      ToolTip="{Binding Selected.Full}" AutomationProperties.Name="{Binding Spot.Label}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- The League tab -->
      <Grid Grid.Row="4" Visibility="{Binding IsLeagueTab, Converter={StaticResource ShowIf}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,4,0,4">
          <ItemsControl ItemsSource="{Binding FinderScopes}" ItemsPanel="{StaticResource Wrapped}" Focusable="False" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseFinderScopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding FinderPositions}" ItemsPanel="{StaticResource Wrapped}" Focusable="False" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseFinderPositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding FinderSorts}" ItemsPanel="{StaticResource Wrapped}" Focusable="False" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseFinderSortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="70" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox Text="{Binding FinderQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Find a player in the league" />
            <TextBlock Text="Search by name" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FinderQuery}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <TextBlock Grid.Column="1" Text="Overall at least" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0" />
          <TextBox Grid.Column="2" Text="{Binding FinderMinimum, UpdateSourceTrigger=PropertyChanged, Delay=200}" TextAlignment="Center" AutomationProperties.Name="Lowest overall to show" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding FinderSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,4" />
        <ListBox Grid.Row="3" ItemsSource="{Binding FinderRows}" ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Players in the league">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Background="Transparent">
                <Grid.InputBindings>
                  <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}" Command="{Binding DataContext.OpenFinderRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Player.Overall}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Player.FullName}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Player.PositionName}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Born}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" ToolTip="Birth year, as stored" />
                <TextBlock Grid.Column="4" Text="{Binding Height}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Team}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- The Checks tab -->
      <Grid Grid.Row="4" Visibility="{Binding IsChecksTab, Converter={StaticResource ShowIf}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ItemsControl ItemsSource="{Binding FinderScopes}" ItemsPanel="{StaticResource Wrapped}" Focusable="False" Margin="0,4,0,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}" CommandParameter="{Binding}"
                        Command="{Binding DataContext.ChooseFinderScopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        <TextBlock Grid.Row="1" Text="{Binding IssuesSummary}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,6" />
        <ListBox Grid.Row="2" ItemsSource="{Binding IssueRows}" ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Things to look at">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Background="Transparent">
                <Grid.InputBindings>
                  <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}" Command="{Binding DataContext.OpenIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Team}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- The Changes tab -->
      <Grid Grid.Row="4" Visibility="{Binding IsChangesTab, Converter={StaticResource ShowIf}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,4,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Start over" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Command="{Binding StartOverCommand}"
                  ToolTip="Go back to the roster you first added to this mod" Visibility="{Binding IsEditing, Converter={StaticResource ShowIf}}" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding ChangeRows}" ItemContainerStyle="{StaticResource PlainRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Changes">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,12,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
                      <TextBlock Text="{Binding Team}" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding What}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Put back" Style="{StaticResource ToolButton}" Margin="10,0,0,0" VerticalAlignment="Center" CommandParameter="{Binding}"
                          Command="{Binding DataContext.RevertPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          ToolTip="Put this player's details and ratings back. Their team stays as it is."
                          Visibility="{Binding CanRevert, Converter={StaticResource ShowIf}}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <!-- The player -->
    <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource Panel}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding WantsWholeWidth}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <TextBlock Text="Pick a player to see them here." Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasPlayer, Converter={StaticResource HideIf}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPlayer, Converter={StaticResource ShowIf}}">
          <StackPanel Margin="18,16,18,20" Grid.IsSharedSizeScope="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding SelectedRow.Player.Jersey}" Foreground="{StaticResource RedLine}" FontFamily="{StaticResource DisplayFont}" FontSize="38" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedRow.Player.FullName}" Style="{StaticResource SubHeading}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PlayerFacts}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ReadOnlyNote}" Foreground="{StaticResource Caution}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding IsEditing, Converter={StaticResource HideIf}}" />
            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource RedLine}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Problem, Converter={StaticResource ShowIfSet}}" />

            <Button Content="Trade or swap" Style="{StaticResource GhostButton}" Command="{Binding StartTradeCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                    ToolTip="Swap this player with one on another team or in the free agents"
                    Visibility="{Binding IsEditing, Converter={StaticResource ShowIf}}" />

            <StackPanel IsEnabled="{Binding IsEditing}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding FirstName}" KeyDown="OnBoxKeyDown" AutomationProperties.Name="First name" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="LAST NAME" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding LastName}" KeyDown="OnBoxKeyDown" AutomationProperties.Name="Last name" />
                </StackPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="NUMBER" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Jersey}" KeyDown="OnBoxKeyDown" AutomationProperties.Name="Number" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="HEIGHT" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Height}" KeyDown="OnBoxKeyDown" AutomationProperties.Name="Height" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="WEIGHT (LB)" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Weight}" KeyDown="OnBoxKeyDown" AutomationProperties.Name="Weight in pounds" />
                </StackPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="BORN (YEAR-MONTH-DAY)" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding BirthDate}" KeyDown="OnBoxKeyDown" AutomationProperties.Name="Birth date" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="BIRTHPLACE" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Birthplace}" KeyDown="OnBoxKeyDown" AutomationProperties.Name="Birthplace" />
                </StackPanel>
              </Grid>

              <StackPanel Visibility="{Binding IsSkater, Converter={StaticResource ShowIf}}">
                <TextBlock Text="POSITION" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Positions}" ItemsPanel="{StaticResource Wrapped}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
              </StackPanel>
              <TextBlock Text="{Binding HandHeading}" Style="{StaticResource FieldLabel}" />
              <ItemsControl ItemsSource="{Binding Hands}" ItemsPanel="{StaticResource Wrapped}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
              <StackPanel Visibility="{Binding CanLetter, Converter={StaticResource ShowIf}}">
                <TextBlock Text="LETTER" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Letters}" ItemsPanel="{StaticResource Wrapped}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />
              </StackPanel>
              <TextBlock Text="STYLE" Style="{StaticResource FieldLabel}" />
              <ItemsControl ItemsSource="{Binding Styles}" ItemsPanel="{StaticResource Wrapped}" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False" />

              <ItemsControl ItemsSource="{Binding RatingGroups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" Margin="0,16,0,4" />
                      <ItemsControl ItemsSource="{Binding Ratings}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="54" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Rating.Label}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <Grid Grid.Column="1" Height="4" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border Background="{StaticResource Line}" CornerRadius="2" />
                                <Border Background="{StaticResource BlueLine}" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" />
                              </Grid>
                              <TextBox Grid.Column="2" Text="{Binding Text}" KeyDown="OnBoxKeyDown" TextAlignment="Center" AutomationProperties.Name="{Binding Rating.Label}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
