<UserControl x:Class="NhlWorkbench.App.Views.TexturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NhlWorkbench.App.Views">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>

    <!-- Library -->
    <Grid Margin="30,22,20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="TEXTURES" Style="{StaticResource Heading}" FontSize="24" />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" />
          <WrapPanel Margin="0,6,0,0">
            <WrapPanel.Resources>
              <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,6,0" />
              </Style>
            </WrapPanel.Resources>
            <Button Content="Save these as PNGs" Command="{Binding SaveShownCommand}" CommandParameter="png" ToolTip="Save the pictures showing to a folder as PNGs" />
            <Button Content="Save as DDS" Command="{Binding SaveShownCommand}" CommandParameter="dds" ToolTip="Save the pictures showing to a folder as DDS files" />
            <Button Content="Import folder" Command="{Binding DataContext.Teams.ImportBundleCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Put pictures into your mod: edits in a folder saved from here, or any pictures named after game textures" />
          </WrapPanel>
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center">
          <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search by team, name or folder" />
          <TextBlock Text="Search by team, name or folder" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Query}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,0,0,10" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource TabButton}" FontSize="14" Margin="0,0,16,8" Tag="{Binding IsActive}"
                    Command="{Binding DataContext.ShowCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
              <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="{Binding Label}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource PlainRow}" SizeChanged="OnListSizeChanged"
               ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource TextureTile}" Loaded="OnTileLoaded" Unloaded="OnTileUnloaded" ToolTip="{Binding File.Path}"
                          Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <StackPanel Width="128">
                      <Grid Height="128">
                        <Border Background="{StaticResource Checker}" CornerRadius="9" />
                        <Image Source="{Binding Thumbnail}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Background="{StaticResource RedLine}" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2"
                                Visibility="{Binding IsChanged, Converter={StaticResource ShowIf}}">
                          <TextBlock Text="EDITED" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="10" />
                        </Border>
                        <Border Background="#D0101A2C" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,2"
                                Visibility="{Binding HasSeveral, Converter={StaticResource ShowIf}}">
                          <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="10" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Margin="2,6,2,0" />
                      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Margin="2,0,2,2" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="Connect your game on the Rink page to see its textures." Visibility="{Binding DataContext.HasGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HideIf}}" />
    </Grid>

    <!-- Detail -->
    <views:TextureDetailPanel Grid.Column="1" />
  </Grid>
</UserControl>
