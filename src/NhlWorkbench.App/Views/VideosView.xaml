<UserControl x:Class="NhlWorkbench.App.Views.VideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="320" />
      <ColumnDefinition Width="480" />
    </Grid.ColumnDefinitions>

    <!-- The movies -->
    <Grid Margin="30,22,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="VIDEOS" Style="{StaticResource Heading}" />
        <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="Every movie in the game. Watch one or save it as an MP4. They can't be replaced." />
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Videos}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource TileItem}" AutomationProperties.Name="Movies">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Width="196" Background="{StaticResource Panel}" CornerRadius="10" ClipToBounds="True">
              <StackPanel>
                <Grid Height="110" Background="{StaticResource Arena}">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <Grid Margin="10,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                  <TextBlock Grid.Column="1" Text="{Binding Length}" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="30,0" IsHitTestVisible="False" />
    </Grid>

    <!-- The movie on show -->
    <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <Grid>
        <TextBlock Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="40,0"
                   Text="Pick a movie to watch it." Visibility="{Binding HasVideo, Converter={StaticResource HideIf}}" />
        <StackPanel Margin="20" Visibility="{Binding HasVideo, Converter={StaticResource ShowIf}}">
          <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource SubHeading}" />
          <TextBlock Text="{Binding Facts}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
          <Border Background="{StaticResource Arena}" CornerRadius="8" ClipToBounds="True" Height="248">
            <Grid>
              <Image Source="{Binding Selected.Thumbnail}" Stretch="Uniform" />
              <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" IsMuted="True"
                            MediaEnded="OnMediaEnded" MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" />
            </Grid>
          </Border>
          <TextBlock x:Name="Position" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
          <Slider x:Name="Seek" Minimum="0" Maximum="1" Margin="0,4,0,10" IsMoveToPointEnabled="True" Thumb.DragStarted="OnSeekStarted" Thumb.DragCompleted="OnSeekCompleted" AutomationProperties.Name="Position in the movie" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PlayButton" Content="Pause" Style="{StaticResource PrimaryButton}" Click="OnPlayPause" MinWidth="88" Margin="0,0,8,0" />
            <Button Content="Save as MP4" Style="{StaticResource GhostButton}" Command="{Binding SaveMp4Command}" Margin="0,0,8,0" />
            <Button Content="Save this frame" Style="{StaticResource GhostButton}" Click="OnSaveFrame" />
          </StackPanel>
          <TextBlock x:Name="NotReady" Text="Getting this movie ready…" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />
          <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,14,0,0" BorderBrush="{StaticResource RedLine}" Visibility="{Binding HasProblem, Converter={StaticResource ShowIf}}">
            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource RedLineHover}" FontSize="12" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
