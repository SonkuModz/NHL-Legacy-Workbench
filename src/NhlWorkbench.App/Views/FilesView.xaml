<UserControl x:Class="NhlWorkbench.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>

    <Grid Margin="30,22,20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="EXPLORER" Style="{StaticResource Heading}" />
      <StackPanel Grid.Row="1" Margin="0,12,0,10">
        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search game files" ToolTip="Search by any part of the path, such as centerlogo or jersey" />
        <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="2,6,0,0" />
      </StackPanel>
      <ListBox Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource RowItem}"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="Connect your game on the Rink page to browse its files." Visibility="{Binding DataContext.HasGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HideIf}}" />
    </Grid>

    <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <Grid>
        <TextBlock Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="40,0"
                   Text="Pick a file to see where it comes from." Visibility="{Binding HasSelection, Converter={StaticResource HideIf}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource ShowIf}}">
          <StackPanel Margin="24,22">
            <TextBlock Text="{Binding Selected.Path}" Style="{StaticResource SubHeading}" TextWrapping="Wrap" />
            <Grid Height="300" Margin="0,16,0,0" Visibility="{Binding Preview, Converter={StaticResource ShowIfSet}}">
              <Border Background="{StaticResource Ice}" CornerRadius="12" />
              <Image Source="{Binding Preview}" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="13" LineHeight="20" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button Content="Save a copy" Style="{StaticResource GhostButton}" Command="{Binding SaveCopyCommand}" />
              <Button Content="Save DDS" Style="{StaticResource GhostButton}" Command="{Binding SaveDdsCommand}" Margin="10,0,0,0" ToolTip="Saves this file's textures as DDS files, with the game's own format and mips" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
