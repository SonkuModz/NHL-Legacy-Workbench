<UserControl x:Class="NhlWorkbench.App.Views.IceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>

    <!-- Library -->
    <Grid Margin="30,22,20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Style="{StaticResource TabButton}" Command="{Binding ShowCenterIceTabCommand}" Tag="{Binding IsCenterIce}">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="{Binding CenterIceCount, StringFormat=Center ice  {0}}" />
          </Button>
          <Button Style="{StaticResource TabButton}" Command="{Binding ShowIceLogosTabCommand}" Tag="{Binding IsIceLogos}">
            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="{Binding IceLogoCount, StringFormat=Ice logos  {0}}" />
          </Button>
        </StackPanel>
        <Grid Grid.Column="1">
          <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search by team or number" />
          <TextBlock Text="Search by team or number" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Query}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>

      <ListBox Grid.Row="1" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding Selected}"
               ItemContainerStyle="{StaticResource TileItem}" ScrollViewer.CanContentScroll="False">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="128">
              <Grid Height="128">
                <Border Background="{StaticResource Ice}" CornerRadius="9" />
                <Image Source="{Binding Thumbnail}" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border Background="{StaticResource RedLine}" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2"
                        Visibility="{Binding IsChanged, Converter={StaticResource ShowIf}}">
                  <TextBlock Text="EDITED" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="10" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Margin="2,6,2,2" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="Connect your game on the Rink page to see its logos." Visibility="{Binding DataContext.HasGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HideIf}}" />
    </Grid>

    <!-- Detail -->
    <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <Grid>
        <TextBlock Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="40,0"
                   Text="Pick a logo to compare it and swap in your own picture." Visibility="{Binding HasSelection, Converter={StaticResource HideIf}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource ShowIf}}">
          <StackPanel Margin="24,22">
            <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource Heading}" FontSize="26" />
            <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,16" />

            <TextBlock Text="{Binding BeforeLabel}" ToolTip="{Binding BeforeLabel}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
            <Grid Height="212">
              <Border Background="{StaticResource Ice}" CornerRadius="12" />
              <Image Source="{Binding Before}" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <TextBlock Text="IN YOUR MOD" Style="{StaticResource Label}" Margin="0,16,0,6" />
            <Grid Height="212">
              <Border Background="{StaticResource Ice}" CornerRadius="12" />
              <Image Source="{Binding After}" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="No change yet" Foreground="#5B6E88" FontFamily="{StaticResource DisplayFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Selected.IsChanged, Converter={StaticResource HideIf}}" />
            </Grid>

            <Button Content="Use my picture" Style="{StaticResource PrimaryButton}" Command="{Binding ReplaceCommand}" Margin="0,18,0,0" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" LineHeight="17" Text="Use a PNG with transparency or an edited DDS. Pictures are fitted to the logo's size and keep their proportions." />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Content="Save PNG" Style="{StaticResource GhostButton}" Command="{Binding SaveOriginalCommand}" ToolTip="Saves your version if you've changed this logo, otherwise what's showing above" />
              <Button Grid.Column="2" Content="Save DDS" Style="{StaticResource GhostButton}" Command="{Binding SaveDdsCommand}" ToolTip="Saves your version if you've changed this logo, otherwise what's showing above" />
              <Button Grid.Column="4" Content="Undo" Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" ToolTip="Takes this logo out of your mod" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
