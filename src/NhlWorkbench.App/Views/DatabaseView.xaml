<UserControl x:Class="NhlWorkbench.App.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="Wrapped"><WrapPanel /></ItemsPanelTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Which database, and its tables -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="14,16,14,0">
          <ItemsControl ItemsSource="{Binding Sources}" ItemsPanel="{StaticResource Wrapped}" Focusable="False" AutomationProperties.Name="Databases">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" ToolTip="{Binding Note}" Style="{StaticResource ChoiceButton}"
                        Command="{Binding DataContext.ChooseSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Source.Note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="14,12,14,8">
          <TextBox Text="{Binding TableQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search tables" />
          <TextBlock Text="Search tables" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TableQuery}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" ItemContainerStyle="{StaticResource RowItem}"
                 Margin="8,0,4,8" AutomationProperties.Name="Tables">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding ChangeNote}" Foreground="{StaticResource Caution}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasChanges, Converter={StaticResource ShowIf}}" />
                <TextBlock Grid.Column="2" Text="{Binding Rows}" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24,0"
                   Text="Connect your game on the Rink page to see its databases." Visibility="{Binding DataContext.HasGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HideIf}}" />
      </Grid>
    </Border>

    <!-- The table -->
    <Grid Grid.Column="1" Margin="24,16,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding TableTitle}" Style="{StaticResource Heading}" FontSize="24" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding TableNote}" Style="{StaticResource Muted}" FontSize="12" />
          <TextBlock Text="{Binding WhereFrom}" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="200" Margin="0,0,8,0">
            <TextBox Text="{Binding RowQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Search this table" />
            <TextBlock Text="Search this table" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RowQuery}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Content="Save as CSV" Style="{StaticResource GhostButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" ToolTip="Save this table for a spreadsheet" />
          <Button Content="Load CSV" Style="{StaticResource GhostButton}" Command="{Binding ImportCsvCommand}" Margin="0,0,8,0" ToolTip="Apply a spreadsheet saved from this table. If any cell is wrong, nothing changes." />
          <Button Content="Undo all" Style="{StaticResource GhostButton}" Command="{Binding UndoAllCommand}" ToolTip="Take this database out of your mod" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1">
        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding HasChanges, Converter={StaticResource ShowIf}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <CheckBox Content="Only changed rows" IsChecked="{Binding OnlyChangedRows}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
              <Button Content="Every change" Style="{StaticResource SmallLink}" Command="{Binding ToggleChangesCommand}" VerticalAlignment="Center" Margin="0,0,14,0" />
              <Button Content="Put this table back" Style="{StaticResource SmallLink}" Command="{Binding PutBackTableCommand}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource Caution}" Visibility="{Binding HasRosterWarning, Converter={StaticResource ShowIf}}">
          <TextBlock Text="{Binding RosterWarning}" Foreground="{StaticResource Caution}" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource RedLine}" Visibility="{Binding HasProblem, Converter={StaticResource ShowIf}}">
          <TextBlock Text="{Binding Problem}" Foreground="{StaticResource RedLineHover}" FontSize="13" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" Style="{StaticResource DataTable}"
                    BeginningEdit="OnBeginningEdit" Sorting="OnSorting" AutomationProperties.Name="Table rows" />
          <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

          <!-- Every change in this database -->
          <Grid Background="{StaticResource Panel}" Visibility="{Binding IsChangesOpen, Converter={StaticResource ShowIf}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="14,12,14,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding ChangesHeading}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Grid Grid.Column="1" Width="200" Margin="12,0,8,0">
                <TextBox Text="{Binding ChangeQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Search the changes" />
                <TextBlock Text="Search the changes" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ChangeQuery}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button Grid.Column="2" Content="Back to the table" Style="{StaticResource GhostButton}" Command="{Binding ToggleChangesCommand}" />
            </Grid>
            <Grid Grid.Row="1" Margin="18,0,32,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="WHERE" Style="{StaticResource Label}" FontSize="10" />
              <TextBlock Grid.Column="1" Text="COLUMN" Style="{StaticResource Label}" FontSize="10" />
              <TextBlock Grid.Column="2" Text="NOW" Style="{StaticResource Label}" FontSize="10" />
              <TextBlock Grid.Column="3" Text="BEFORE" Style="{StaticResource Label}" FontSize="10" />
            </Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding ChangeRows}" ItemContainerStyle="{StaticResource PlainRow}" Margin="8,0,8,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Every change">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Background="Transparent" Cursor="Hand" ToolTip="Show this cell in its table">
                    <Grid.InputBindings>
                      <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.GoToChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="1.3*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,3,10,3">
                      <TextBlock Text="{Binding Where}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Column}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Now}" Foreground="{StaticResource Caution}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Now}" />
                    <TextBlock Grid.Column="3" Text="{Binding Was}" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Was}" />
                    <Button Grid.Column="4" Content="Put back" Style="{StaticResource SmallLink}" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Command="{Binding DataContext.PutBackCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
