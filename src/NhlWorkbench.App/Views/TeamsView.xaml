<UserControl x:Class="NhlWorkbench.App.Views.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NhlWorkbench.App.ViewModels"
             xmlns:views="clr-namespace:NhlWorkbench.App.Views">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <!-- The teams, by league -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="14,16,14,10">
          <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search teams" />
          <TextBlock Text="Search teams" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Query}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" ItemContainerStyle="{StaticResource TeamRowItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Teams">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="16,14,8,6" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="40" Loaded="OnEntryLoaded" Unloaded="OnEntryUnloaded">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Color}" CornerRadius="2" Margin="0,5" />
                <Image Grid.Column="1" Source="{Binding Crest.Thumbnail}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <Border Grid.Column="3" Background="{StaticResource RedLine}" CornerRadius="5" Padding="6,1" Margin="6,0,8,0" VerticalAlignment="Center"
                        Visibility="{Binding HasEdits, Converter={StaticResource ShowIf}}" ToolTip="Files edited in your mod">
                  <TextBlock Text="{Binding EditCount}" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="10" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24,0" TextWrapping="Wrap"
                   Text="Connect your game on the Rink page to see its teams." Visibility="{Binding DataContext.HasGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HideIf}}" />
      </Grid>
    </Border>

    <!-- The team's bundle -->
    <Grid Grid.Column="1" Margin="24,20,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,12" Visibility="{Binding HasTeam, Converter={StaticResource ShowIf}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="64" Height="64" Margin="0,0,14,0">
          <Border Background="{Binding SelectedTeam.Color}" CornerRadius="12" Opacity="0.28" />
          <Image Source="{Binding SelectedTeam.Crest.Thumbnail}" Margin="5" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedTeam.Name}" Style="{StaticResource Heading}" FontSize="26" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding TeamFacts}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
          <WrapPanel Margin="0,6,0,0">
            <WrapPanel.Resources>
              <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,6,4" />
              </Style>
            </WrapPanel.Resources>
            <Button Content="Roster" Command="{Binding OpenRosterCommand}" ToolTip="See this team's players" />
            <Button Content="Rename" Command="{Binding OpenRenameCommand}" ToolTip="Change this team's name, city, nickname and abbreviation in every language" />
            <Button Content="Horn and chants" Command="{Binding OpenSoundsCommand}" ToolTip="Hear this team's goal horn and chants" />
            <Button Content="Export PNGs" Command="{Binding ExportBundleCommand}" CommandParameter="png" ToolTip="Save all this team's art to a folder as PNGs, easiest to paint on" />
            <Button Content="Export DDS" Command="{Binding ExportBundleCommand}" CommandParameter="dds" ToolTip="Save all this team's art to a folder as DDS files, with the game's own format and mips" />
            <Button Content="Import" Command="{Binding ImportBundleCommand}" ToolTip="Put the pictures you edited in an exported folder into your mod, or a folder of pictures named after game textures" />
          </WrapPanel>
        </StackPanel>
      </Grid>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="0,0,0,10" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource TabButton}" FontSize="14" Margin="0,0,14,6" Tag="{Binding IsActive}"
                    Command="{Binding DataContext.ShowTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
              <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}" Text="{Binding Label}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ListBox Grid.Row="2" ItemsSource="{Binding Lines}" ItemContainerStyle="{StaticResource PlainRow}" SizeChanged="OnListSizeChanged"
               ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.Resources>
          <DataTemplate DataType="{x:Type vm:TeamHeadingLine}">
            <StackPanel Orientation="Horizontal" Margin="2,10,0,8">
              <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Kit, Converter={StaticResource ShowIfSet}}">
                <Button Content="Save PNGs" Style="{StaticResource SmallLink}" Margin="0,0,10,0" ToolTip="Save this uniform's pieces to a folder as PNGs" CommandParameter="{Binding Kit}"
                        Command="{Binding DataContext.ExportKitPngCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button Content="Save DDS" Style="{StaticResource SmallLink}" ToolTip="Save this uniform's pieces to a folder as DDS files" CommandParameter="{Binding Kit}"
                        Command="{Binding DataContext.ExportKitDdsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:TeamTilesLine}">
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource TeamTile}" Loaded="OnTileLoaded" Unloaded="OnTileUnloaded" ToolTip="{Binding Item.File.Path}"
                          Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <StackPanel Width="128">
                      <Grid Height="128">
                        <Border Background="{StaticResource Checker}" CornerRadius="9" />
                        <Image Source="{Binding Item.Thumbnail}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Background="{StaticResource RedLine}" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2"
                                Visibility="{Binding Item.IsChanged, Converter={StaticResource ShowIf}}">
                          <TextBlock Text="EDITED" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="10" />
                        </Border>
                        <Border Background="#D0101A2C" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,2"
                                Visibility="{Binding Item.HasSeveral, Converter={StaticResource ShowIf}}">
                          <TextBlock Text="{Binding Item.CountText}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="10" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Margin="2,6,2,2" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ListBox.Resources>
      </ListBox>

      <TextBlock Grid.Row="2" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>

    <!-- What's picked -->
    <views:TextureDetailPanel Grid.Column="2" DataContext="{Binding Textures}" />

    <!-- Renaming the team -->
    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="{Binding IsRenameOpen, Converter={StaticResource ShowIf}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,20">
          <TextBlock Text="Rename team" Style="{StaticResource SubHeading}" FontSize="20" />
          <TextBlock Text="{Binding RenameNote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14" />
          <TextBlock Text="FULL NAME" Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,4" />
          <TextBox Text="{Binding RenameFull, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Full name" />
          <TextBlock Text="CITY" Style="{StaticResource Label}" FontSize="10" Margin="0,12,0,4" />
          <TextBox Text="{Binding RenameCity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="City" />
          <TextBlock Text="NICKNAME" Style="{StaticResource Label}" FontSize="10" Margin="0,12,0,4" />
          <TextBox Text="{Binding RenameNickname, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nickname" />
          <TextBlock Text="SHORT NICKNAME" Style="{StaticResource Label}" FontSize="10" Margin="0,12,0,4" />
          <TextBox Text="{Binding RenameShort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Short nickname" />
          <TextBlock Text="ABBREVIATION" Style="{StaticResource Label}" FontSize="10" Margin="0,12,0,4" />
          <TextBox Text="{Binding RenameAbbreviation, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="Abbreviation" />
          <TextBlock Text="{Binding RenameProblem}" Foreground="{StaticResource RedLine}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasRenameProblem, Converter={StaticResource ShowIf}}" />
          <Button Content="Save in every language" Style="{StaticResource PrimaryButton}" Command="{Binding SaveRenameCommand}" Margin="0,16,0,0" />
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Put back the game's names" Style="{StaticResource GhostButton}" Command="{Binding PutBackNamesCommand}" Margin="0,0,8,0" />
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CloseRenameCommand}" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
