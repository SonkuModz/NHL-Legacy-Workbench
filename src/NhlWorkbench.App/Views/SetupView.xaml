<UserControl x:Class="NhlWorkbench.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="30,22,30,20" MaxWidth="880" HorizontalAlignment="Stretch">
      <TextBlock Text="WELCOME TO THE WORKBENCH" Style="{StaticResource Heading}" />
      <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,4" TextWrapping="Wrap"
                 Text="A modding tool for NHL Legacy Edition on the PS3 recomp. Here's how to go from nothing to your first mod in game." />
      <TextBlock Text="{Binding Progress}" Foreground="{StaticResource Ice}" FontFamily="{StaticResource DisplayFont}" FontSize="15" Margin="0,6,0,14" TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.Name="Setup steps">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="18,14" Margin="0,0,0,10">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource BlueLine}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="38" Height="38" VerticalAlignment="Top" Margin="0,2,16,0">
                  <Ellipse StrokeThickness="2">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Stroke" Value="{StaticResource Line}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource RedLine}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Good}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding Mark}" FontFamily="{StaticResource DisplayFont}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource SubHeading}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,6,8,0">
                          <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsPrimary, Converter={StaticResource ShowIf}}" />
                          <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource GhostButton}" Visibility="{Binding IsPrimary, Converter={StaticResource HideIf}}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding FfmpegNote}" Style="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0" TextWrapping="Wrap"
                 Text="Press F1 to come back to this page, and Ctrl+/ to see every keyboard shortcut." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
